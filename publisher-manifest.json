om:1px dashed var(--line);padding-bottom:18px}\n.plan-step:nth-child(2) .annual{color:var(--ivory);opacity:.7;border-color:rgba(251,246,236,.4)}\n.plan-step .feat{list-style:none;counter-reset:f}\n.plan-step .feat li{padding:9px 0 9px 22px;position:relative;font-size:13.5px;border-bottom:1px dotted var(--line-soft);line-height:1.6}\n.plan-step .feat li:last-child{border-bottom:none}\n.plan-step:nth-child(2) .feat li{border-color:rgba(251,246,236,.25)}\n.plan-step .feat li::before{content:\"⎯\";position:absolute;left:0;top:9px;color:var(--wine-soft);font-size:14px}\n.plan-footnote{text-align:center;margin-top:36px;font-size:12.5px;color:var(--muted);letter-spacing:1px}\n\n.faq-block{padding:84px 0}\n.faq-groups{display:grid;grid-template-columns:repeat(2,1fr);gap:42px}\n.faq-group h3{font-family:\"Songti SC\",serif;font-size:17px;color:var(--wine-deep);margin-bottom:18px;padding-bottom:10px;border-bottom:1.5px dashed var(--wine-soft);letter-spacing:1px}\n.faq-q{margin-bottom:22px}\n.faq-q summary{cursor:pointer;font-family:\"Songti SC\",serif;color:var(--wine-deep);font-size:15px;padding:8px 0;list-style:none;position:relative;padding-left:22px;letter-spacing:.5px}\n.faq-q summary::-webkit-details-marker{display:none}\n.faq-q summary::before{content:\"Q\";position:absolute;left:0;top:8px;font-family:\"Songti SC\",serif;color:var(--wine);font-weight:700;font-size:14px}\n.faq-q summary::after{content:\"+\";position:absolute;right:0;top:6px;color:var(--wine-soft);font-size:18px}\n.faq-q[open] summary::after{content:\"−\"}\n.faq-q p{margin-top:8px;padding-left:22px;font-size:13.5px;color:var(--ink);line-height:1.85;position:relative}\n.faq-q p::before{content:\"A\";position:absolute;left:0;top:0;color:var(--wine-soft);font-weight:700;font-size:12px;font-family:\"Songti SC\",serif}\n\n.cta-bar{background:var(--wine);color:var(--ivory);padding:64px 0;border-bottom:6px solid var(--wine-deep);border-top:2px solid var(--wine-deep)}\n.cta-bar h2{font-family:\"Songti SC\",serif;font-size:30px;margin-bottom:14px;font-weight:700;letter-spacing:1px}\n.cta-bar p{font-size:14.5px;opacity:.85;max-width:680px;line-height:1.85}\n.cta-actions{margin-top:26px;display:flex;gap:18px;flex-wrap:wrap}\n.cta-actions a.ticket{border:1.5px dashed var(--ivory);padding:10px 22px;font-size:13px;letter-spacing:2px;color:var(--ivory)}\n.cta-actions a.ticket:hover{background:var(--ivory);color:var(--wine-deep)}\n.cta-actions a.alt{border-color:rgba(251,246,236,.5);font-size:13px;letter-spacing:2px}\n\nfooter.colophon{padding:48px 0 56px;background:var(--paper);color:var(--muted);font-size:12.5px;letter-spacing:1px;border-top:1px solid var(--line)}\n.colophon-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:36px}\n.colophon-grid h4{font-family:\"Songti SC\",serif;color:var(--wine-deep);font-size:13px;margin-bottom:14px;letter-spacing:2px}\n.colophon-grid p{line-height:1.9}\n.colophon-grid ul{list-style:none}\n.colophon-grid li{padding:4px 0;border-bottom:1px dotted var(--line-soft)}\n.colophon-grid li:last-child{border-bottom:none}\n.colophon-grid li a{font-size:12.5px}\n.copyrow{margin-top:42px;padding-top:20px;border-top:1px dashed var(--line);display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;font-size:11.5px;letter-spacing:1.5px}\n\n@media (max-width:880px){\n.hero h1{font-size:36px}\n.hero-grid{grid-template-columns:1fr}\n.hero-grid > div{padding:18px 0;border-left:none;border-top:1px dashed var(--line)}\n.hero-grid > div:first-child{padding-top:0;border-top:none}\n.plans-stage{flex-direction:column;align-items:stretch;gap:18px}\n.plan-step{margin:0;max-width:none;transform:none !important}\n.plan-step:nth-child(2){padding:30px 26px}\n.faq-groups{grid-template-columns:1fr;gap:30px}\n.colophon-grid{grid-template-columns:1fr;gap:24px}\n.hero-stripe2 .row{gap:6px;font-size:12px}\n}\n</style><header class=\"brandbar\">\n  <div class=\"wrap brandbar-inner\">\n    <div class=\"brand-mark\">桥<span class=\"sep\"></span>头<span class=\"sep\"></span>堡</div>\n    <small>QIAO TOU BAO · NETWORK WORKBENCH</small>\n  </div>\n</header>\n\n<main>\n\n<section class=\"hero band\" aria-label=\"首屏\">\n\n<div class=\"hero-stripe1\">\n  <div class=\"wrap\">\n    <span class=\"hero-tag\">2024 · 跨境协作工作台</span>\n    <h1>把远方的路，<em>一站</em>整理清楚。<br>桥头堡，让每一次连线都走在既定的渠里。</h1>\n    <p class=\"hero-sub\">我们不想成为屏幕后面默默运转的「黑箱」。桥头堡是一张张摊在桌上的工作清单——流量、设备、流媒体节点、专线与售后，全部以可核对的方式陈列，你只需要照单挑选，再照单使用。</p>\n  </div>\n</div>\n\n<div class=\"hero-stripe2\">\n  <div class=\"wrap row\">\n    <span>本月新增 14 条 IPLC 专线测试段</span>\n    <span>三档定价，阶梯式呈现</span>\n    <span>工作日 12 小时内必回工单</span>\n  </div>\n</div>\n\n<div class=\"hero-stripe3\">\n  <div class=\"wrap\">\n    <div class=\"hero-grid\">\n      <div>\n        <h3>它是什么</h3>\n        <p>一份为长期跨境协作与远程办公的人准备的「联网手册」。三档订阅对应不同的流量与并发设备需求，付完款就发货，不藏菜单外选项。</p>\n      </div>\n      <div>\n        <h3>它不是什么</h3>\n        <p>不是即时翻墙器、不是按次计费的工具人，也不是承诺永不掉线的玄学系统。我们卖的是工作时段内的稳定与售后时效。</p>\n      </div>\n      <div>\n        <h3>谁来用它</h3>\n        <p>驻外的工程师、跨时区的设计组、需要走专线视频会议的小团队，以及每月数据流稳定但总被琐碎节点切换打断的个人用户。</p>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div class=\"wrap hero-footstrip\">\n  <a class=\"link\" href=\"#plans\">查看三档定价</a>\n  <span class=\"dot\">·</span>\n  <a class=\"link\" href=\"#use\">使用方法</a>\n  <span class=\"dot\">·</span>\n  <a class=\"link\" href=\"#faq\">常见问题</a>\n  <span class=\"dot\">·</span>\n  <a class=\"link\" href=\"#contact\">开工单</a>\n</div>\n\n</section>\n\n<section class=\"block\" id=\"use\">\n  <div class=\"wrap\">\n    <div class=\"sect-head\">\n      <div class=\"num\">01 — USAGE</div>\n      <h2>四步把路修好，再坐回工位</h2>\n      <p>桥头堡的使用节奏是「先选档位，再登客户端，最后由工单把剩下的细枝末节接走」。每一步写明耗时，写明谁来接手。</p>\n    </div>\n\n    <div class=\"steps\">\n      <div class=\"step-row\">\n        <div class=\"n\">01</div>\n        <div>\n          <h3>挑一档订阅</h3>\n          <p>在下方阶梯图里挑一档，照单付款，得到一组账号密钥与订阅有效期。我们不接受非订阅的散单合作。</p>\n          <ul>\n            <li>支持月付与年付，年付折算后每月更省</li>\n            <li>密钥在工作日 4 小时内发放到注册邮箱</li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"step-row\">\n        <div class=\"n\">02</div>\n        <div>\n          <h3>下载客户端</h3>\n          <p>拿到密钥后再回到本页，择一支持的系统版本安装客户端。我们仅提供客户端链接，不放镜像、不挂第三方渠道。</p>\n          <ul>\n            <li>客户端随系统更新自动推送补丁，无需重装</li>\n            <li>旧版本不支持的设备由我们出书面替换方案</li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"step-row\">\n        <div class=\"n\">03</div>\n        <div>\n          <h3>导入节点，按场景选路</h3>\n          <p>登录后从节点列表里按用途选择：会议专线、流媒体原生解锁、低延迟游戏段、或是冷数据备份段。每一档对应可见的节点池。</p>\n          <ul>\n            <li>节点命名直接表明用途，无需猜</li>\n            <li>遇到延迟异常，客户端内一键上报就是工单</li>\n          </ul>\n        </div>\n      </div>\n\n      <div class=\"step-row\">\n        <div class=\"n\">04</div>\n        <div>\n          <h3>把售后留给工单</h3>\n          <p>设置出现偏好变更、设备增减、节点失效，全部以工单形式提交，避免私聊的零散记忆。我们承诺回复时效，写在套餐里。</p>\n          <ul>\n            <li>工作日 12 小时内首次回复</li>\n            <li>续费、停服、退订在同一张工单里闭环</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section class=\"plans\" id=\"plans\">\n  <div class=\"wrap\">\n    <div class=\"sect-head\">\n      <div class=\"num\">02 — PRICING</div>\n      <h2>三档阶梯，挑你本月用得上的那一档</h2>\n      <p>从左到右依次加重：流量更大、设备更多、节点更专、售后更密。中间一档是大多数跨州协作小组的常用档，旁边会有「⌗ 推荐」标记。</p>\n    </div>\n\n    <div class=\"plans-stage\">\n\n      <article class=\"plan-step\">\n        <div class=\"tier\">TIER · 01</div>\n        <h3>基础版</h3>\n        <div class=\"price\">¥15<small> /月</small></div>\n        <div class=\"annual\">按年付仅需 ¥150/年</div>\n        <ul class=\"feat\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </article>\n\n      <article class=\"plan-step\">\n        <div class=\"tier\">TIER · 02 · 多数团队</div>\n        <h3>旗舰版</h3>\n        <div class=\"price\">¥35<small> /月</small></div>\n        <div class=\"annual\">按年付仅需 ¥350/年</div>\n        <ul class=\"feat\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n      </article>\n\n      <article class=\"plan-step\">\n        <div class=\"tier\">TIER · 03</div>\n        <h3>团队版</h3>\n        <div class=\"price\">¥85<small> /月</small></div>\n        <div class=\"annual\">按年付仅需 ¥850/年</div>\n        <ul class=\"feat\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </article>\n\n    </div>\n\n    <p class=\"plan-footnote\">所有档位按自然月计费，跨月剩余流量不结转；升级档位当月生效，按差额补差。</p>\n  </div>\n</section>\n\n<section class=\"faq-block\" id=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"sect-head\">\n      <div class=\"num\">03 — FAQ</div>\n      <h2>常见问题，按主题分好了格子</h2>\n      <p>我们把问题归成四组：订阅与发票、设备与客户端、节点与流量、售后与退订。如果下面没有覆盖到，开工单即可，由人工逐条回复。</p>\n    </div>\n\n    <div class=\"faq-groups\">\n\n      <div class=\"faq-group\">\n        <h3>订阅与发票</h3>\n\n        <details class=\"faq-q\">\n          <summary>桥头堡三档订阅可以中途升降级吗？</summary>\n          <p>支持。升级档位从当日起生效，按原档位剩余天数与新档位差额结算；降档自下一个完整计费月起生效，避免账期中途的流量与设备数倒挂。升降级都在同一张工单里受理。</p>\n        </details>\n\n        <details class=\"faq-q\">\n          <summary>年付是一次性支付还是分期？</summary>\n          <p>一次性支付，对应有效期 12 个月整。年付费用不会因中途降档或部分月份不使用被退回，建议先以月付试用一周期再选择年付。</p>\n        </details>\n\n        <details class=\"faq-q\">\n          <summary>是否开具发票？</summary>\n          <p>提供普通增值税电子发票。下单时备注抬头与纳税人识别号，工单回复里附 PDF；纸质发票需额外说明邮寄地址，邮费由购买方承担。</p>\n        </details>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>设备与客户端</h3>\n\n        <details class=\"faq-q\">\n          <summary>同时在线的设备数是怎么计算的？</summary>\n          <p>以同一账号密钥登录的客户端实例计，登录后即时在线计入，不区分设备类型。基础版可同时保持 3 路，旗舰版 5 路，团队版 20 路。</p>\n        </details>\n\n        <details class=\"faq-q\">\n          <summary>支持哪些系统？</summary>\n          <p>客户端支持 Windows、macOS、iOS、Android，以及常见桌面发行版的命令行形态。旧版操作系统的兼容问题请提交工单，由我们出具书面说明，不擅自承诺。</p>\n        </details>\n\n        <details class=\"faq-q\">\n          <summary>客户端会读取本地哪些信息？</summary>\n          <p>仅读取为建立连接所必需的网络接口信息、登录态与节点使用偏好。不会读取本地文件、剪贴板或浏览器历史。具体字段在客户端首次启动时以可读文本声明。</p>\n        </details>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>节点与流量</h3>\n\n        <details class=\"faq-q\">\n          <summary>「原生流媒体解锁」是什么意思？</summary>\n          <p>指在该节点出口对主流流媒体平台走原生解析路径，回程识别为该地区常规 IP，从而避免平台侧的二次验证。具体覆盖清单以客户端内为准。</p>\n        </details>\n\n        <details class=\"faq-q\">\n          <summary>流量用超后会发生什么？</summary>\n          <p>当月流量耗尽时，连接不会立即中断，但限速至 1Mbps 用于基础通讯，直到下月自然重置或你升级档位补充流量。不会自动加价扣费。</p>\n        </details>\n\n        <details class=\"faq-q\">\n          <summary>IPLC 专线与普通线路的区别？</summary>\n          <p>IPLC 专线是端到端物理通道，延迟更稳、受高峰时段影响更小，适合视频会议与实时协作；普通线路走公网中转，延迟浮动较大但成本更低。两者在节点命名里直接标注。</p>\n        </details>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>售后与退订</h3>\n\n        <details class=\"faq-q\">\n          <summary>工单的回复时效是多久？</summary>\n          <p>基础版与旗舰版工作日 12 小时内首次回复；旗舰版的工单标记「优先」后处理时段进一步前置。团队版由专属客户经理在工作日全时段承接。</p>\n        </details>\n\n        <details class=\"faq-q\">\n          <summary>可以退订吗？</summary>\n          <p>月付档位在首次开通 7 天内可申请全额退订，需在工单内说明原因；年付档位以已使用月份按月付价格扣除后退还剩余款项。退订流程均经由人工核对，不依赖自动按钮。</p>\n        </details>\n\n        <details class=\"faq-q\">\n          <summary>如何停止自动续费？</summary>\n          <p>在订阅到期前 72 小时通过工单告知停服即可，到期当日系统不再发起扣款。无需登录后台、无需找第三方代扣。</p>\n        </details>\n      </div>\n\n    </div>\n  </div>\n</section>\n\n<section class=\"cta-bar\" id=\"contact\">\n  <div class=\"wrap\">\n    <h2>把账单留下，把工序带走</h2>\n    <p>开通任意一档订阅后，工单里将一次性给你：节点清单、设备数、专线段命名、售后响应范围。下面两张票是接下来会看到的样子。</p>\n    <div class=\"cta-actions\">\n      <a class=\"ticket\" href=\"#plans\">查看三档订阅</a>\n      <a class=\"alt\" href=\"#faq\">先翻一遍问答</a>\n    </div>\n  </div>\n</section>\n\n</main>\n\n<footer class=\"colophon\">\n  <div class=\"wrap\">\n    <div class=\"colophon-grid\">\n      <div>\n        <h4>关于桥头堡</h4>\n        <p>桥头堡是一份为跨境协作与远程办公整理的联网工作台。所有定价、设备上限与售后时效均以本页陈列为准，不在订阅菜单外承诺额外权益。</p>\n      </div>\n      <div>\n        <h4>本页索引</h4>\n        <ul>\n          <li><a href=\"#use\">使用方法</a></li>\n          <li><a href=\"#plans\">三档定价</a></li>\n          <li><a href=\"#faq\">常见问题</a></li>\n          <li><a href=\"#contact\">开工单</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>条款与说明</h4>\n        <ul>\n          <li>服务以自然月计费</li>\n          <li>设备计数以在线实例为准</li>\n          <li>退订流程经工单核对</li>\n          <li>本页内容会随节点调整更新</li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"copyrow\">\n      <span>© 桥头堡 · QIAO TOU BAO</span>\n      <span>本页内容仅说明服务结构，不构成额外承诺</span>\n    </div>\n  </div>\n</footer>",
